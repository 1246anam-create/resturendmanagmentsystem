# =====================================================================
# Restaurant Management System - Environment Configuration
# =====================================================================
# IMPORTANT: Never commit real secrets. This file is for local config.

# Flask
SECRET_KEY=restaurant-super-secret-key-change-me-in-production

# Database (SQLite - no PostgreSQL required)
# The app uses SQLite by default. Uncomment to explicitly set:
# DATABASE_URL=sqlite:///restaurant.db

# Uploads
UPLOAD_FOLDER=static/uploads

# App environment: development | production | testing
FLASK_ENV=development

# Mail (optional - used for notifications if configured)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@restaurant.com
